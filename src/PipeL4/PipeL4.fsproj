<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>pipel4</ToolCommandName>
    <PackageId>PipeL4</PackageId>
    <Version>0.1.0-alpha.1</Version>
    <Authors>Michael Krotenko</Authors>
    <PackageDescription>Experimental TCP byte-stream proxy and runtime with F# .fsx processor plugins.</PackageDescription>
    <PackageTags>tcp;proxy;byte-stream;F#;dotnet-tool;plugin</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Copyright>2026 Michael Krotenko</Copyright>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RestoreEnablePackagePruning>false</RestoreEnablePackagePruning>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="../../examples/AsciiUppercase.fsx" LogicalName="PipeL4.Examples.AsciiUppercase.fsx" />
    <EmbeddedResource Include="../../examples/BytePatternReplace.fsx" LogicalName="PipeL4.Examples.BytePatternReplace.fsx" />
    <EmbeddedResource Include="../../examples/PrefixMode.fsx" LogicalName="PipeL4.Examples.PrefixMode.fsx" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="ExampleDistribution.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="THIRD_PARTY_NOTICES.md" Pack="true" PackagePath="\" />
    <None Include="notices/FSharp.LICENSE.txt" Pack="true" PackagePath="notices/" />
    <None Include="notices/DotNet.LICENSE.txt" Pack="true" PackagePath="notices/" />
    <None Include="notices/DotNet.THIRD-PARTY-NOTICES.txt" Pack="true" PackagePath="notices/" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../PipeL4.Core/PipeL4.Core.fsproj" />
    <ProjectReference Include="../PipeL4.Plugins/PipeL4.Plugins.fsproj" />
  </ItemGroup>

  <Import Project="..\..\.paket\Paket.Restore.targets" />

</Project>
