<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RestoreEnablePackagePruning>false</RestoreEnablePackagePruning>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="ConnectionStateBenchmarks.fs" />
    <Compile Include="RawTcpForwardingBenchmarks.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Scripts/PassThrough.fsx" LogicalName="PipeL4.Benchmarks.Scripts.PassThrough.fsx" />
    <EmbeddedResource Include="Scripts/GeneratedOutput.fsx" LogicalName="PipeL4.Benchmarks.Scripts.GeneratedOutput.fsx" />
    <EmbeddedResource Include="Scripts/StateAccess.fsx" LogicalName="PipeL4.Benchmarks.Scripts.StateAccess.fsx" />
    <EmbeddedResource Include="Scripts/CachedState.fsx" LogicalName="PipeL4.Benchmarks.Scripts.CachedState.fsx" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/PipeL4.Core/PipeL4.Core.fsproj" />
    <ProjectReference Include="../../src/PipeL4.Plugins/PipeL4.Plugins.fsproj" />
  </ItemGroup>

  <Import Project="..\..\.paket\Paket.Restore.targets" />

</Project>
