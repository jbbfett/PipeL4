<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <OutputType>Exe</OutputType>
    <RestoreEnablePackagePruning>false</RestoreEnablePackagePruning>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="AssemblyInfo.fs" />
    <Compile Include="TestRepository.fs" />
    <Compile Include="CapacityAccountingTests.fs" />
    <Compile Include="DiagnosticsTests.fs" />
    <Compile Include="ForwardingConfigurationTests.fs" />
    <Compile Include="ConnectionStateTests.fs" />
    <Compile Include="TcpForwarderIntegrationTests.fs" />
    <Compile Include="ProcessorContractTests.fs" />
    <Compile Include="ProcessorPipelineTests.fs" />
    <Compile Include="ScriptProcessorTests.fs" />
    <Compile Include="ScriptCompilerTests.fs" />
    <Compile Include="ScriptPipelineTests.fs" />
    <Compile Include="ScriptTcpForwarderIntegrationTests.fs" />
    <Compile Include="ExampleProcessorTests.fs" />
    <Compile Include="BytePatternReplaceTests.fs" />
    <Compile Include="PrefixModeTests.fs" />
    <Compile Include="CliAcceptanceTests.fs" />
    <Compile Include="InstalledToolIntegrationTests.fs" />
    <Compile Include="SmokeTests.fs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/PipeL4.Core/PipeL4.Core.fsproj" />
    <ProjectReference Include="../../src/PipeL4.Plugins/PipeL4.Plugins.fsproj" />
    <ProjectReference Include="../../src/PipeL4/PipeL4.fsproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <Import Project="..\..\.paket\Paket.Restore.targets" />

</Project>
